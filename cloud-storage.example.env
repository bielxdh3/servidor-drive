# Root.ark cloud storage integration
# Keep CLOUD_STORAGE_PROVIDER=local to use only the local disk.
CLOUD_STORAGE_PROVIDER=local
CLOUD_STORAGE_PREFIX=rootark

# AWS S3
# CLOUD_STORAGE_PROVIDER=s3
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-rootark-bucket
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# Optional for MinIO/Cloudflare R2/local S3-compatible providers:
# AWS_ENDPOINT_URL=https://your-s3-compatible-endpoint
# AWS_FORCE_PATH_STYLE=true

# Google Drive
# CLOUD_STORAGE_PROVIDER=gdrive
# GOOGLE_DRIVE_FOLDER_ID=your-shared-drive-folder-id
# Use one of these credential options:
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\rootark-service-account.credentials.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
